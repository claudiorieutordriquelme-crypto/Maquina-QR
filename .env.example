# La URL y la anon key son publicas por diseno: viajan al navegador en cada
# request. Lo que protege los datos es Row Level Security, no el secreto de
# estas dos variables.
NEXT_PUBLIC_SUPABASE_URL=https://pnxnvorvuvkodutwordo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base de todos los QR impresos. Si el dominio cambia despues de imprimir una
# flota, las etiquetas quedan apuntando al dominio viejo y hay que reimprimir.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solo server-side. Se necesita recien en la Etapa 7, para firmar URLs de
# facturas del bucket privado. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Cuenta de demostracion que se publica en el recuadro de /login, para que
# cualquiera pueda entrar a mirar el panel.
#
# Tiene que ser SIEMPRE una cuenta de solo lectura: el login es alcanzable
# desde internet, asi que publicar una con permiso de escritura equivale a
# dejar la base abierta.
#
# Si estas dos quedan vacias, el recuadro no se renderiza y la demo queda
# apagada sin necesidad de tocar codigo. El valor no va en este archivo
# a proposito: es una contraseña, y aca no van contraseñas ni de demostracion.
DEMO_EMAIL=
DEMO_PASSWORD=
