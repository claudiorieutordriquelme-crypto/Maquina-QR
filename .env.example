# La URL y la anon key son publicas por diseno: viajan al navegador en cada
# request. Lo que protege los datos es Row Level Security, no el secreto de
# estas dos variables.
NEXT_PUBLIC_SUPABASE_URL=https://pnxnvorvuvkodutwordo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base de todos los QR impresos. Si el dominio cambia despues de imprimir una
# flota, las etiquetas quedan apuntando al dominio viejo y hay que reimprimir.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Solo server-side. Se necesita recien en la Etapa 7, para firmar URLs de
# facturas del bucket privado. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
